{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "daily-one-shot",
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "[DEV] Create today's post",
        "description": "Run the daily handler now for the current UTC day",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/dev-create-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
